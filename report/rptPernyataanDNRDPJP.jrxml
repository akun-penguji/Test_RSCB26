				<reportElement x="0" y="193" width="555" height="15" uuid="c8547ea0-8bba-499a-af36-0a4be92a0550"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[Perintah atau pernyataan dokter penanggung jawab pelayanan]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="209" width="555" height="15" uuid="ff127808-4602-446e-80c5-4953b0ebe86d"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[Saya dokter yang bertanda tangan di bawah ini menginstruksikan kepada seluruh staf medis dan staf klinis]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="223" width="555" height="15" uuid="3b510caf-f9a7-45c7-8132-512178746676"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[lainnya untuk melakukan hal-hal tertulis di bawah ini :]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="241" width="555" height="15" uuid="26cb25ae-e707-42c9-92dd-57e6170c53a8"/>
				<textElement verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{perintah_dnr}.equals("1")?"[X]":"[  ]"+" 1. Usahakan komprehensif untuk mencegah henti jantung nafas tanpa melakukan intubasi"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="15" y="255" width="540" height="15" uuid="b9b6db34-a8aa-4916-ae09-08bafd50b91b"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[DO NOT RESUSCITATE, TIDAK DILAKUKAN RESUSITASI JANTUNG PARU (RJP)]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="273" width="555" height="15" uuid="b2a12a23-5c53-4447-9cf2-87510662d205"/>
				<textElement verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{perintah_dnr}.equals("2")?"[X]":"[  ]"+" 2. Usaha suportif sebelum terjadi henti nafas atau henti jantung yang meliputi pembukaan"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="15" y="287" width="540" height="15" uuid="90efa6de-0756-4456-ba1d-54564f580c70"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[jalan nafas non invasif, mengontrol pendarahan, memposisikan pasien dengan nyaman,]]></text>
			</staticText>
			<staticText>
				<reportElement x="15" y="301" width="540" height="15" uuid="dabd15e0-9f6f-4d33-9f9b-f51568150a6d"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[pemberian obat-obatan anti nyeri. TIDAK MELAKUKAN RESUSITASI JANTUNG PARU (RJP)]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="321" width="555" height="15" uuid="50f44610-b826-4e4f-b174-0e62d3084a70"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[Keputusan DNR di atas diambil setelah pasien diberikan penjelasan dan informed consent diperoleh dari :]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="337" width="555" height="15" uuid="08760e20-0b37-4569-b21e-3ccbeb9fa729"/>
				<textElement verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["   "+$F{informed_consent_dari}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="355" width="555" height="15" uuid="0a967fd8-33e8-4f28-a784-8711ddb048e3"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[Dasar perintah DNR :]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
