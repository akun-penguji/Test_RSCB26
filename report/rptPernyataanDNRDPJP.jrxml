				<reportElement x="5" y="26" width="545" height="15" uuid="ebbc5ea5-04f3-4f2e-95e8-e300b2f3c25f"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[FORMULIR PERNYATAAN JANGAN DILAKUKAN RESUSITASI]]></text>
			</staticText>
			<staticText>
				<reportElement x="5" y="41" width="545" height="15" uuid="a9214876-fdb9-47d0-9266-85b78f221962"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[DNR (DO NOT RESUSCITATE)]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="68" width="555" height="15" uuid="8cdea3ee-3620-47d0-b3b3-e2062fe51e44"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[Formulir ini adalah perintah dokter penanggung jawab pelayanan kepada seluruh staf klinis rumah sakit agar]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="82" width="555" height="15" uuid="785660f4-ed65-4264-80e5-37a4972227ca"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[tidak dilakukan resusitasi pada pasien ini bila terjadi henti jantung dan henti nafas.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="96" width="555" height="15" uuid="c3ae438c-1024-4d06-8a68-339ae2eebffe"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[Formulir ini juga memberikan perintah kepada staff medis untuk tetap melakukan intervensi atau]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="110" width="555" height="15" uuid="2439883e-4566-48d6-8357-bceef10926e0"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[pengobatan, atau tata laksana lainnya sebelum terjadinya henti jantung atau henti nafas.]]></text>
			</staticText>
			<staticText>
				<reportElement x="30" y="132" width="100" height="15" uuid="8420614b-b273-4adf-a753-de1234c1854c"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
