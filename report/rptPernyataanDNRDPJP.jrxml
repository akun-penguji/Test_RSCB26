	<queryString>
		<![CDATA[select d.*,r.no_rkm_medis,p.nm_pasien as nm_pasien_reg,dk.nm_dokter from pernyataan_dnr_dpjp d inner join reg_periksa r on d.no_rawat=r.no_rawat inner join pasien p on r.no_rkm_medis=p.no_rkm_medis left join dokter dk on d.kd_dokter=dk.kd_dokter]]>
	</queryString>
