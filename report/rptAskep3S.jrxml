	<queryString>
		<![CDATA[SELECT ad.id, ad.kode_sdki, ad.label_sdki, ad.etiologi, ad.tanda_mayor, ad.tanda_minor,
                        COALESCE(ms.jenis, '') AS jenis
                 FROM askep_diagnosis ad
                 LEFT JOIN mst_sdki ms ON ms.id = ad.id_sdki
                 WHERE ad.id_header = $P{HEADER_ID}
                 ORDER BY ad.urutan]]>
	</queryString>
	<field name="id" class="java.lang.Integer"/>
	<field name="kode_sdki" class="java.lang.String"/>
