	<queryString><![CDATA[select a.*,r.no_rkm_medis,p.nm_pasien,p.tgl_lahir,p.no_ktp,pt.nama as nm_petugas from asesmen_risiko_jatuh_getupgo a inner join reg_periksa r on a.no_rawat=r.no_rawat inner join pasien p on r.no_rkm_medis=p.no_rkm_medis left join petugas pt on a.nip=pt.nip]]></queryString>
