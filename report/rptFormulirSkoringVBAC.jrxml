		<![CDATA[select skoring_vbac.no_rawat, pasien.no_rkm_medis, pasien.nm_pasien, skoring_vbac.tgl_pengkajian, skoring_vbac.jam_pengkajian, skoring_vbac.usia_40_tahun, skoring_vbac.riwayat_pervaginam, skoring_vbac.alasan_sc_selain_cpd, skoring_vbac.pendarahan_serviks, skoring_vbac.dilatasi_serviks, skoring_vbac.total_skor, skoring_vbac.evaluasi_interpretasi, skoring_vbac.kd_petugas, petugas.nama from skoring_vbac inner join reg_periksa on skoring_vbac.no_rawat=reg_periksa.no_rawat inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis inner join petugas on skoring_vbac.kd_petugas=petugas.nip]]>
	</queryString>
