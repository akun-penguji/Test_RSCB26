	<queryString>
		<![CDATA[SELECT 
    rp.no_rawat,
    p.no_rkm_medis,
    p.nm_pasien,
    p.jk,
    p.tgl_lahir,
    p.alamat,
    frk.tanggal,
    d.nm_dokter,
    frk.kelompok_robson,
    frk.paritas,
    frk.riwayat_sc,
    frk.onset_persalinan,
    frk.presentasi,
    frk.usia_kehamilan,
    frk.jumlah_janin,
    frk.indikasi_sc,
    frk.kondisi_ibu,
    frk.kondisi_bayi,
    frk.berat_bayi,
    frk.apgar_score,
    frk.komplikasi,
    frk.tindakan_tambahan,
    frk.lama_rawat,
    frk.keterangan
FROM reg_periksa rp
INNER JOIN pasien p ON rp.no_rkm_medis = p.no_rkm_medis
INNER JOIN form_robson_klasifikasi frk ON rp.no_rawat = frk.no_rawat
INNER JOIN dokter d ON frk.kd_dokter = d.kd_dokter]]>
	</queryString>
