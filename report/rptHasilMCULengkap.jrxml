	<parameter name="no_rawat" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT hm.no_rawat, IFNULL(hm.no_mcu,'') as no_mcu, rp.tgl_registrasi, p.no_rkm_medis, p.nm_pasien, p.jk, p.tmp_lahir, 
		DATE_FORMAT(p.tgl_lahir,'%d-%m-%Y') as tgl_lahir, p.gol_darah, p.stts_nikah, p.agama, 
		DATE_FORMAT(rp.tgl_registrasi,'%d-%m-%Y') as tgl_daftar, p.no_tlp, p.alamat, p.pekerjaan,
		TIMESTAMPDIFF(YEAR, p.tgl_lahir, CURDATE()) AS umur, p.pnd, p.keluarga, p.namakeluarga,
		pj.png_jawab, DATE_FORMAT(hm.tanggal,'%d-%m-%Y %H:%i') as tanggal, hm.kd_dokter, d.nm_dokter,
		hm.riwayat_sekarang, hm.riwayat_dahulu, hm.riwayat_keluarga, hm.riwayat_kebiasaan,
		hm.tanda_vital, hm.bb_tb, hm.kepala, hm.mulut, hm.leher, hm.tht, hm.thorax, hm.abdomen, 
		hm.ekstremitas, hm.hematologi, hm.urin, hm.kimia_darah, hm.radiologi, hm.ekg, 
		hm.kesimpulan, hm.saran
		FROM hasil_mcu hm 
		LEFT JOIN reg_periksa rp ON hm.no_rawat = rp.no_rawat 
		LEFT JOIN pasien p ON rp.no_rkm_medis = p.no_rkm_medis 
		LEFT JOIN dokter d ON hm.kd_dokter = d.kd_dokter 
		LEFT JOIN penjab pj ON rp.kd_pj = pj.kd_pj 
		WHERE hm.no_rawat = $P{no_rawat}]]>
	</queryString>
