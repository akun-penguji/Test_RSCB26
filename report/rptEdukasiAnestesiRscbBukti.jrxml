	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kabupatenrs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="photo" class="java.lang.String"/>
	<parameter name="signature" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ea.*, r.no_rkm_medis, p.nm_pasien, p.tgl_lahir as tgl_lahir_pasien, if(p.jk='L','Laki-laki','Perempuan') as jk_pasien, concat(p.alamat,', ',kelurahan.nm_kel,', ',kecamatan.nm_kec,', ',kabupaten.nm_kab) as alamat_pasien, d.nm_dokter, pt.nama as nm_petugas from edukasi_anestesi_rscb ea inner join reg_periksa r on ea.no_rawat=r.no_rawat inner join pasien p on r.no_rkm_medis=p.no_rkm_medis inner join kelurahan on p.kd_kel=kelurahan.kd_kel inner join kecamatan on p.kd_kec=kecamatan.kd_kec inner join kabupaten on p.kd_kab=kabupaten.kd_kab inner join dokter d on ea.kd_dokter=d.kd_dokter inner join petugas pt on ea.nip=pt.nip]]>
	</queryString>
