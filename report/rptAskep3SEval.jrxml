                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tgl_evaluasi} + "  |  Shift: " + $F{shift} + "  |  " + ($F{nm_perawat} != null ? $F{nm_perawat} : "")]]></textFieldExpression>
