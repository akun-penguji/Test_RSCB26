<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptAskep3SEval" language="groovy"
              pageWidth="555" pageHeight="842" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              uuid="d188e557-6ad5-41be-b032-00ff477b00d4">
    <parameter name="DIAG_ID" class="java.lang.Integer"/>
    <queryString>
        <![CDATA[SELECT ae.tgl_evaluasi, ae.shift, ae.soap_s, ae.soap_o, ae.soap_a, ae.soap_p,
                        ae.kesimpulan, ae.nm_perawat
                 FROM askep_evaluasi ae
                 WHERE ae.id_diagnosis = $P{DIAG_ID}
                 ORDER BY ae.tgl_evaluasi, ae.id]]>
    </queryString>
    <field name="tgl_evaluasi" class="java.lang.String"/>
    <field name="shift" class="java.lang.String"/>
    <field name="soap_s" class="java.lang.String"/>
    <field name="soap_o" class="java.lang.String"/>
    <field name="soap_a" class="java.lang.String"/>
    <field name="soap_p" class="java.lang.String"/>
    <field name="kesimpulan" class="java.lang.String"/>
    <field name="nm_perawat" class="java.lang.String"/>
    <detail>
        <band height="80" splitType="Stretch">
            <!-- Header evaluasi -->
            <rectangle>
