<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptEvaluasiKetepatanLaporan" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b2c3d4e5-1111-4222-8333-444455556677">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="periode" class="java.lang.String"/>
	<field name="unit" class="java.lang.String"/>
	<field name="nama_laporan" class="java.lang.String"/>
	<field name="jml_wajib" class="java.lang.Double"/>
	<field name="jml_tepat" class="java.lang.Double"/>
	<field name="jml_telat" class="java.lang.Double"/>
	<field name="jml_belum" class="java.lang.Double"/>
	<field name="persen_tepat" class="java.lang.Double"/>
	<field name="rerata_telat" class="java.lang.Double"/>
	<variable name="wajibUnit" class="java.lang.Double" resetType="Group" resetGroup="GrupUnit" calculation="Sum">
		<variableExpression><![CDATA[$F{jml_wajib}]]></variableExpression>
	</variable>
	<variable name="tepatUnit" class="java.lang.Double" resetType="Group" resetGroup="GrupUnit" calculation="Sum">
		<variableExpression><![CDATA[$F{jml_tepat}]]></variableExpression>
	</variable>
	<variable name="wajibTotal" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jml_wajib}]]></variableExpression>
	</variable>
	<variable name="tepatTotal" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{jml_tepat}]]></variableExpression>
	</variable>
	<group name="GrupUnit">
		<groupExpression><![CDATA[$F{unit}]]></groupExpression>
		<groupHeader>
			<band height="36">
				<textField>
					<reportElement mode="Opaque" x="0" y="2" width="802" height="14" backcolor="#E8EEF6"/>
					<box leftPadding="4"><pen lineWidth="0.5"/></box>
					<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="8" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["UNIT : "+($F{unit}==null||$F{unit}.trim().equals("")?"- Belum Ditentukan -":$F{unit})]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement mode="Opaque" x="0" y="17" width="300" height="18" backcolor="#F0F0DC"/>
					<box leftPadding="2"><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6" isBold="true"/></textElement>
					<text><![CDATA[Nama Laporan]]></text>
				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="300" y="17" width="80" height="18" backcolor="#F0F0DC"/>
					<box leftPadding="2"><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6" isBold="true"/></textElement>
					<text><![CDATA[Wajib Kirim]]></text>
				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="380" y="17" width="80" height="18" backcolor="#F0F0DC"/>
					<box leftPadding="2"><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6" isBold="true"/></textElement>
					<text><![CDATA[Tepat Waktu]]></text>
				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="460" y="17" width="80" height="18" backcolor="#F0F0DC"/>
					<box leftPadding="2"><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6" isBold="true"/></textElement>
					<text><![CDATA[Terlambat]]></text>
				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="540" y="17" width="80" height="18" backcolor="#F0F0DC"/>
					<box leftPadding="2"><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6" isBold="true"/></textElement>
					<text><![CDATA[Belum Dikirim]]></text>
				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="620" y="17" width="90" height="18" backcolor="#F0F0DC"/>
					<box leftPadding="2"><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6" isBold="true"/></textElement>
					<text><![CDATA[% Tepat Waktu]]></text>
				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="710" y="17" width="92" height="18" backcolor="#F0F0DC"/>
					<box leftPadding="2"><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6" isBold="true"/></textElement>
					<text><![CDATA[Rerata Telat (hari)]]></text>
				</staticText>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="18">
				<textField>
					<reportElement x="0" y="0" width="802" height="14"/>
					<box leftPadding="4"><pen lineWidth="0.5"/></box>
					<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["Capaian ketepatan waktu unit ini : "+($V{wajibUnit}>0?Math.round($V{tepatUnit}*10000.0/$V{wajibUnit})/100.0:0)+" %  (tepat "+$V{tepatUnit}.intValue()+" dari "+$V{wajibUnit}.intValue()+" laporan)"]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
	<title>
		<band height="92">
			<image scaleImage="RetainShape" isUsingCache="true" onErrorType="Blank">
				<reportElement x="1" y="4" width="45" height="45"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField>
				<reportElement x="0" y="2" width="802" height="17"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="12" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{namars}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="19" width="802" height="13"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{alamatrs}+", "+$P{kotars}+", "+$P{propinsirs}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="32" width="802" height="13"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{kontakrs}+"   E-mail : "+$P{emailrs}]]></textFieldExpression>
			</textField>
			<line><reportElement x="0" y="50" width="802" height="1"/><graphicElement><pen lineWidth="2.0" lineStyle="Double"/></graphicElement></line>
			<staticText>
				<reportElement x="0" y="56" width="802" height="16"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="10" isBold="true"/></textElement>
				<text><![CDATA[EVALUASI KETEPATAN WAKTU PENYAMPAIAN LAPORAN]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="72" width="802" height="13"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{periode}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<detail>
		<band height="14">
			<textField isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement x="0" y="0" width="300" height="14"/>
				<box leftPadding="2"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[$F{nama_laporan}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement x="300" y="0" width="80" height="14"/>
				<box leftPadding="2"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[$F{jml_wajib}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement x="380" y="0" width="80" height="14"/>
				<box leftPadding="2"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[$F{jml_tepat}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement x="460" y="0" width="80" height="14"/>
				<box leftPadding="2"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[$F{jml_telat}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement x="540" y="0" width="80" height="14"/>
				<box leftPadding="2"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[$F{jml_belum}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement x="620" y="0" width="90" height="14"/>
				<box leftPadding="2"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[$F{persen_tepat}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.0" isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement x="710" y="0" width="92" height="14"/>
				<box leftPadding="2"><pen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[$F{rerata_telat}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="14">
			<textField>
				<reportElement x="602" y="0" width="200" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA["Halaman "+$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="46">
			<textField>
				<reportElement mode="Opaque" x="0" y="4" width="802" height="16" backcolor="#E8EEF6"/>
				<box leftPadding="4"><pen lineWidth="0.5"/></box>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA["CAPAIAN KETEPATAN WAKTU PELAPORAN SELURUH UNIT : "+($V{wajibTotal}>0?Math.round($V{tepatTotal}*10000.0/$V{wajibTotal})/100.0:0)+" %  (tepat "+$V{tepatTotal}.intValue()+" dari "+$V{wajibTotal}.intValue()+" laporan)"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="24" width="802" height="18"/>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7" isItalic="true"/></textElement>
				<text><![CDATA[Dievaluasi setiap semester dan dilaporkan kepada Direktur. Keterlambatan wajib disertai alasan dan tindak lanjut kepala unit terkait.]]></text>
			</staticText>
		</band>
	</summary>
