	</variable>
	<variable name="capaianTotal" class="java.lang.Double" calculation="Average">
		<variableExpression><![CDATA[$F{hasilhitung}]]></variableExpression>
	</variable>
	<group name="GrupUnit">
		<groupExpression><![CDATA[$F{nama_ruang}]]></groupExpression>
		<groupHeader>
			<band height="34">
