	<variable name="capaianUnit" class="java.lang.Double" resetType="Group" resetGroup="GrupUnit" calculation="Average">
		<variableExpression><![CDATA[$F{hasilhitung}]]></variableExpression>
	</variable>
	<variable name="jmlUnit" class="java.lang.Integer" resetType="Group" resetGroup="GrupUnit" calculation="Count">
