				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="28" y="17" width="70" height="16" backcolor="#F0F0DC"/>
					<box><pen lineWidth="0.5"/></box>
					<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="7" isBold="true"/></textElement>
