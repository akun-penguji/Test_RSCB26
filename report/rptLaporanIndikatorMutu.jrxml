					<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="8" isBold="true"/></textElement>
					<textFieldExpression><![CDATA["UNIT / AREA : "+($F{nama_ruang}==null||$F{nama_ruang}.trim().equals("")?"- Belum Ditentukan -":$F{nama_ruang})]]></textFieldExpression>
