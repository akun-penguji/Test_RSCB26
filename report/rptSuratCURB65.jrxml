	<queryString>
		<![CDATA[select pemantauan_curb65.no_rawat,reg_periksa.no_rkm_medis,pasien.nm_pasien,pasien.tgl_lahir,pasien.jk,
pemantauan_curb65.tanggal,pemantauan_curb65.skor_confusion,pemantauan_curb65.skor_bun,
pemantauan_curb65.skor_rr,pemantauan_curb65.skor_bp,pemantauan_curb65.skor_usia,
pemantauan_curb65.total_skor,petugas.nama 
from pemantauan_curb65 inner join reg_periksa on pemantauan_curb65.no_rawat=reg_periksa.no_rawat 
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
inner join petugas on pemantauan_curb65.nip=petugas.nip 
where pemantauan_curb65.no_rawat=$P{no_rawat} and pemantauan_curb65.tanggal=$P{tanggal}]]>
	</queryString>
