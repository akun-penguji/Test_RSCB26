					<font fontName="Tahoma" size="10" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[Integer.parseInt($F{total_skor}) <= 1 ? "Low Risk (Rawat Jalan)" : 
(Integer.parseInt($F{total_skor}) == 2 ? "Medium Risk (Rawat Inap Singkat)" : 
(Integer.parseInt($F{total_skor}) == 3 ? "Medium-High Risk (Rawat Inap)" : "High Risk (Rawat ICU)"))]]></textFieldExpression>
			</textField>
		</band>
	</detail>
