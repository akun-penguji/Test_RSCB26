	<queryString>
		<![CDATA[select da.no_rawat, da.tanggal, r.no_rkm_medis, p.nm_pasien, p.alamat, concat(r.umurdaftar,' ',r.sttsumur) as umur,
da.tindakan, da.jenis_anestesi, da.catatan, pt.nama as nm_petugas,
pre.puasa, pre.kondisi_kulit, pre.preop_kesadaran, pre.gcs, pre.kesimpulan, pre.gangguan_sensorik,
pre.muskuloskeletal, pre.protesa, pre.edema, pre.respirasi, pre.kondisi_psikologis, pre.laboratorium, pre.data_penunjang,
pre.informed_consent, pre.identitas_pasien, pre.lavamen, pre.isolasi, pre.marking, pre.alergi, pre.verifikasi_tindakan,
pre.riwayat_asma, pre.ekg, pre.foto_thorax, pre.riwayat_hepatitis, pre.penyakit_lain, pre.waktu_pengukuran,
ms.masalah_preop_kecemasan, ms.cemas_tingkat, ms.intervensi_cemas, ms.masalah_preop_nyeri, ms.intervensi_nyeri,
io.klasifikasi_luka, io.posisi_operasi, io.aseptik_antiseptik, io.aseptik_oleh, io.kateter, io.kateter_no, io.kateter_urine_cc, io.kateter_oleh,
io.drain_intraop, io.drain_intraop_jenis, io.drain_intraop_cc, io.tampon_intraop, io.tampon_intraop_jenis, io.tampon_intraop_lokasi,
io.gips, io.gips_jenis, io.gips_lokasi, io.matras_penghangat, io.cairan_iv_hangat, io.irigasi_hangat,
io.sabuk_pengaman, io.plat_grounding, io.elektrokauter_koagulasi, io.elektrokauter_cutting, io.kulit_setelah_plate,
io.tourniquet_waktu, io.tourniquet_tekanan, io.cairan_infus, io.urine, io.ngt, io.pemberian_darah,
po.jam_masuk_rr, po.td, po.hr, po.spo2, po.rr, po.jenis_anestesi_postop, po.kulit_postop, po.respirasi_postop,
po.kesadaran, po.posisi_pasien, po.lama_anestesi, po.lama_operasi, po.diagnosa_postop, po.drain, po.tampon, po.pa,
dg.efektifitas_jalan_nafas, dg.hipotermi_postop, dg.nip_perawat_rr, dg.nip_perawat_ruangan
from asuhan_keperawatan_kamar_bedah_data_awal da
inner join reg_periksa r on da.no_rawat=r.no_rawat
inner join pasien p on r.no_rkm_medis=p.no_rkm_medis
left join petugas pt on da.nip=pt.nip
left join askep_kb_preop pre on da.no_rawat=pre.no_rawat and da.tanggal=pre.tanggal
left join askep_kb_masalah ms on da.no_rawat=ms.no_rawat and da.tanggal=ms.tanggal
left join askep_kb_intraop io on da.no_rawat=io.no_rawat and da.tanggal=io.tanggal
left join askep_kb_postop po on da.no_rawat=po.no_rawat and da.tanggal=po.tanggal
left join askep_kb_diagnosa dg on da.no_rawat=dg.no_rawat and da.tanggal=dg.tanggal]]>
	</queryString>
