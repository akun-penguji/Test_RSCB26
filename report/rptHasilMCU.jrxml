			<!-- II. PEMERIKSAAN FISIK -->
			<staticText>
				<reportElement x="22" y="120" width="200" height="15" uuid="8a6b9c0d-1e2f-3a4b-5c6d-3f2a1b0c9d8e"/>
				<textElement>
					<font fontName="Tahoma" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[II. PEMERIKSAAN FISIK]]></text>
			</staticText>
			
			<staticText>
				<reportElement x="22" y="140" width="150" height="12" uuid="9b7c0d1e-2f3a-4b5c-6d7e-4a3b2c1d0e9f"/>
				<textElement>
					<font fontName="Tahoma" size="9"/>
				</textElement>
				<text><![CDATA[1. Tanda-tanda Vital]]></text>
