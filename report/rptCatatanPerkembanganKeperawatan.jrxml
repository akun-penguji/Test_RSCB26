	<queryString>
		<![CDATA[select cpk.*, r.no_rkm_medis, p.nm_pasien, pt1.nama as nm_pj_katim, pt2.nama as nm_pj_serah_terima from catatan_perkembangan_keperawatan cpk inner join reg_periksa r on cpk.no_rawat=r.no_rawat inner join pasien p on r.no_rkm_medis=p.no_rkm_medis left join petugas pt1 on cpk.nip_pj=pt1.nip left join petugas pt2 on cpk.nip_pj_serah=pt2.nip where cpk.no_rawat=? and cpk.tanggal=? order by cpk.shift]]>
	</queryString>
