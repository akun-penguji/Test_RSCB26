	<queryString>
		<![CDATA[select m.no_rawat, r.no_rkm_medis, p.nm_pasien, r.umurdaftar, r.sttsumur, p.jk, p.tgl_lahir, m.tanggal, m.jam,
                    m.materi_edukasi, m.kode_leaflet, m.lama_edukasi, m.hasil_verifikasi, m.tgl_re_edukasi, m.nip, pet.nama as nama_petugas,
                    b.photo, b.tandatangan, r.tgl_registrasi, r.jam_reg
                    from materi_edukasi_pasien_keluarga_rscb m 
                    inner join reg_periksa r on m.no_rawat=r.no_rawat 
                    inner join pasien p on r.no_rkm_medis=p.no_rkm_medis 
                    inner join pegawai pet on m.nip=pet.nik 
                    left join bukti_pelaksanaan_informasi_edukasi b on m.no_rawat=b.no_rawat and b.tanggal=concat(m.tanggal,' ',m.jam)]]>
	</queryString>
