<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptMonitoringPeralatanSingleUseReuse" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kabupatenrs" class="java.lang.String"/>
	<parameter name="namapenata" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="no_rkm_medis" class="java.lang.String"/>
	<field name="tanggal" class="java.sql.Timestamp"/>
	<field name="nama_alat" class="java.lang.String"/>
	<field name="ukuran" class="java.lang.String"/>
	<field name="kode_warna" class="java.lang.String"/>
	<variable name="no" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{nama_alat}]]></variableExpression>
	</variable>
	<title>
		<band height="120">
			<staticText>
				<reportElement x="0" y="0" width="535" height="16"/>
				<textElement textAlignment="Center"><font size="10"/></textElement>
				<text><![CDATA[DINAS KESEHATAN KABUPATEN BEKASI]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="16" width="535" height="18"/>
				<textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{namars}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="34" width="535" height="14"/>
				<textElement textAlignment="Center"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{alamatrs}==null?"":$P{alamatrs}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="52" width="535" height="1"/>
			</line>
			<staticText>
				<reportElement x="0" y="62" width="535" height="18"/>
				<textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
				<text><![CDATA[MONITORING PERALATAN SINGLE USE YANG DI REUSE]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="88" width="80" height="14"/>
				<textElement><font size="9"/></textElement>
				<text><![CDATA[Nama Pasien]]></text>
			</staticText>
			<textField>
				<reportElement x="85" y="88" width="300" height="14"/>
				<textElement><font size="9"/></textElement>
				<textFieldExpression><![CDATA[": "+($F{nm_pasien}==null?"":$F{nm_pasien})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="102" width="80" height="14"/>
				<textElement><font size="9"/></textElement>
				<text><![CDATA[No.RM]]></text>
			</staticText>
			<textField>
				<reportElement x="85" y="102" width="300" height="14"/>
				<textElement><font size="9"/></textElement>
				<textFieldExpression><![CDATA[": "+($F{no_rkm_medis}==null?"":$F{no_rkm_medis})]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy">
				<reportElement x="385" y="102" width="150" height="14"/>
				<textElement><font size="9"/></textElement>
				<textFieldExpression><![CDATA["Tanggal : "+new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{tanggal})]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="22">
			<staticText>
				<reportElement x="0" y="0" width="45" height="22" backcolor="#E8E8E8"/>
				<box><pen lineWidth="0.5"/><topPen lineWidth="0.5"/><leftPen lineWidth="0.5"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
				<text><![CDATA[NO.]]></text>
