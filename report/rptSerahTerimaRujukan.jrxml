<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptSerahTerimaRujukan" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="387c522f-9905-46a4-a319-32784eeeac75">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kabupatenrs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[select str.*, r.no_rkm_medis, p.nm_pasien, p.tgl_lahir, p.alamat, concat(r.umurdaftar,' ',r.sttsumur) as umur,
d.nm_dokter, pt.nama as nm_petugas
from serah_terima_rujukan str
inner join reg_periksa r on str.no_rawat=r.no_rawat
inner join pasien p on r.no_rkm_medis=p.no_rkm_medis
left join dokter d on str.dokter_merawat=d.kd_dokter
left join petugas pt on str.nip_menyerahkan=pt.nip]]>
	</queryString>
