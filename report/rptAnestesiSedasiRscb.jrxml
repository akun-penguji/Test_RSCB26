			<staticText><reportElement x="270" y="183" width="45" height="12"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[Infus]]></text></staticText>
			<staticText><reportElement x="315" y="183" width="55" height="12"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[Ket]]></text></staticText>
			<staticText><reportElement x="370" y="183" width="75" height="12"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[Medikasi]]></text></staticText>
			<staticText><reportElement x="445" y="183" width="55" height="12"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[Perdrhn]]></text></staticText>
			<staticText><reportElement x="500" y="183" width="55" height="12"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[Urine]]></text></staticText>
			<componentElement>
				<reportElement x="0" y="195" width="555" height="13"/>
				<jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Vertical">
					<datasetRun subDataset="dsMon"><datasetParameter name="no_rawat"><datasetParameterExpression><![CDATA[$P{no_rawat}]]></datasetParameterExpression></datasetParameter><connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression></datasetRun>
					<jr:listContents height="13" width="555">
						<textField isBlankWhenNull="true"><reportElement x="0" y="0" width="55" height="13"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="5"/></textElement><textFieldExpression><![CDATA[$F{tgl}==null?"":$F{tgl}.substring(11,16)]]></textFieldExpression></textField>
						<textField isBlankWhenNull="true"><reportElement x="55" y="0" width="50" height="13"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="5"/></textElement><textFieldExpression><![CDATA[$F{sistol}+"/"+$F{diastol}]]></textFieldExpression></textField>
						<textField isBlankWhenNull="true"><reportElement x="105" y="0" width="35" height="13"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="5"/></textElement><textFieldExpression><![CDATA[$F{nadi}]]></textFieldExpression></textField>
						<textField isBlankWhenNull="true"><reportElement x="140" y="0" width="30" height="13"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="5"/></textElement><textFieldExpression><![CDATA[$F{rr}]]></textFieldExpression></textField>
						<textField isBlankWhenNull="true"><reportElement x="170" y="0" width="35" height="13"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="5"/></textElement><textFieldExpression><![CDATA[$F{spo2}]]></textFieldExpression></textField>
