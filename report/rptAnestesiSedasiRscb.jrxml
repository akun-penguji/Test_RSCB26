			<staticText><reportElement x="0" y="67" width="555" height="12"/><textElement><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[A. CHECKLIST PERSIAPAN SEDASI]]></text></staticText>
			<textField isBlankWhenNull="true"><reportElement x="15" y="80" width="175" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[("Ya".equals($F{cl_informed_consent})?"[X] ":"[  ] ")+"Informed Consent"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="195" y="80" width="185" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[("Ya".equals($F{cl_obat_anestesi})?"[X] ":"[  ] ")+"Obat-obatan Anestesi"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="385" y="80" width="170" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[("Ya".equals($F{cl_tatalaksana_napas})?"[X] ":"[  ] ")+"Tatalaksana Jalan Napas"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="15" y="91" width="175" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[("Ya".equals($F{cl_mesin_anestesi})?"[X] ":"[  ] ")+"Mesin Anestesi"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="195" y="91" width="185" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[("Ya".equals($F{cl_obat_emergensi})?"[X] ":"[  ] ")+"Obat-obatan Emergensi"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="385" y="91" width="170" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[("Ya".equals($F{cl_monitoring})?"[X] ":"[  ] ")+"Monitoring"]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="15" y="102" width="175" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA[("Ya".equals($F{cl_suction})?"[X] ":"[  ] ")+"Suction Aparatus"]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="118" width="555" height="12"/><textElement><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[B. PENILAIAN PRA SEDASI]]></text></staticText>
			<textField isBlankWhenNull="true"><reportElement x="15" y="131" width="530" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA["Kesadaran : "+$F{pra_kesadaran}+"     GCS  E:"+$F{gcs_e}+" V:"+$F{gcs_v}+" M:"+$F{gcs_m}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="15" y="142" width="530" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA["Airway : "+$F{pra_airway}+"      Tekanan Darah : "+$F{pra_td}+" mmHg   Nadi : "+$F{pra_nadi}+" x/mnt "+$F{pra_nadi_reg}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="15" y="153" width="530" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA["Respirasi RR : "+$F{pra_rr}+" x/mnt   Kanul : "+$F{pra_kanul}+"   O2 : "+$F{pra_o2}+" L/mnt   SPO2 : "+$F{pra_spo2}+" %"]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="170" width="555" height="12"/><textElement><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[MONITORING]]></text></staticText>
			<staticText><reportElement x="0" y="183" width="55" height="12"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[Jam]]></text></staticText>
