<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptAnestesiSedasiRscb" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<subDataset name="dsMon">
		<parameter name="no_rawat" class="java.lang.String"/>
		<queryString><![CDATA[SELECT CAST(tanggal AS CHAR) tgl, sistol, diastol, nadi, rr, spo2, o2, suhu, infus, keterangan, medikasi, perdarahan, urine FROM catatan_sedasi_monitoring WHERE no_rawat=$P{no_rawat} ORDER BY tanggal]]></queryString>
		<field name="tgl" class="java.lang.String"/><field name="sistol" class="java.lang.String"/><field name="diastol" class="java.lang.String"/><field name="nadi" class="java.lang.String"/><field name="rr" class="java.lang.String"/><field name="spo2" class="java.lang.String"/><field name="o2" class="java.lang.String"/><field name="suhu" class="java.lang.String"/><field name="infus" class="java.lang.String"/><field name="keterangan" class="java.lang.String"/><field name="medikasi" class="java.lang.String"/><field name="perdarahan" class="java.lang.String"/><field name="urine" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dsMonPasca">
		<parameter name="no_rawat" class="java.lang.String"/>
		<queryString><![CDATA[SELECT CAST(tanggal AS CHAR) tgl, sistol, diastol, nadi, rr, spo2, o2, suhu, infus, keterangan FROM catatan_sedasi_monitoring_pasca WHERE no_rawat=$P{no_rawat} ORDER BY tanggal]]></queryString>
		<field name="tgl" class="java.lang.String"/><field name="sistol" class="java.lang.String"/><field name="diastol" class="java.lang.String"/><field name="nadi" class="java.lang.String"/><field name="rr" class="java.lang.String"/><field name="spo2" class="java.lang.String"/><field name="o2" class="java.lang.String"/><field name="suhu" class="java.lang.String"/><field name="infus" class="java.lang.String"/><field name="keterangan" class="java.lang.String"/>
	</subDataset>
	<parameter name="no_rawat" class="java.lang.String"/>
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kabupatenrs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<queryString><![CDATA[SELECT r.no_rkm_medis, p.nm_pasien, p.tgl_lahir, p.jk,
  CAST(pr.tanggal AS CHAR) tanggal, pr.diagnosis, pr.tindakan, pr.jam_awal, pr.jenis_sedasi, pr.asisten,
  dd.nm_dokter nm_dokter, IFNULL(pn.nama,'') nm_penata,
  pr.cl_informed_consent, pr.cl_obat_anestesi, pr.cl_tatalaksana_napas, pr.cl_mesin_anestesi, pr.cl_obat_emergensi, pr.cl_monitoring, pr.cl_suction,
  pr.kesadaran pra_kesadaran, pr.gcs_e, pr.gcs_v, pr.gcs_m, pr.airway pra_airway, pr.td pra_td, pr.nadi pra_nadi, pr.nadi_reg pra_nadi_reg, pr.rr pra_rr, pr.kanul pra_kanul, pr.o2 pra_o2, pr.spo2 pra_spo2,
  IFNULL(sl.letak,'') sl_letak, IFNULL(sl.airway,'') sl_airway, IFNULL(sl.lama_sedasi,'') lama_sedasi, IFNULL(sl.lama_tindakan,'') lama_tindakan, IFNULL(sl.jam_akhir,'') jam_akhir, IFNULL(sl.medikasi,'') medikasi,
  IFNULL(ps.kesadaran,'') pasca_kesadaran, IFNULL(ps.airway,'') pasca_airway, IFNULL(ps.td,'') pasca_td, IFNULL(ps.nadi,'') pasca_nadi, IFNULL(ps.nadi_reg,'') pasca_nadi_reg, IFNULL(ps.rr,'') pasca_rr, IFNULL(ps.kanul,'') pasca_kanul, IFNULL(ps.o2,'') pasca_o2, IFNULL(ps.spo2,'') pasca_spo2, IFNULL(ps.aldrete,'') aldrete, IFNULL(ps.keluar_jam,'') keluar_jam, IFNULL(ps.pindah_ke,'') pindah_ke,
  IFNULL(ps.ins_pemantauan,'') ins_pemantauan, IFNULL(ps.ins_posisi,'') ins_posisi, IFNULL(ps.ins_nyeri,'') ins_nyeri, IFNULL(ps.ins_mual_muntah,'') ins_mual_muntah, IFNULL(ps.ins_diet,'') ins_diet, IFNULL(ps.ins_obat_lain,'') ins_obat_lain, IFNULL(ps.ins_lain,'') ins_lain,
  IFNULL(prw.nama,'') nm_perawat
FROM catatan_sedasi_pra pr
  INNER JOIN reg_periksa r ON pr.no_rawat=r.no_rawat
  INNER JOIN pasien p ON r.no_rkm_medis=p.no_rkm_medis
  LEFT JOIN dokter dd ON pr.kd_dokter=dd.kd_dokter
  LEFT JOIN petugas pn ON pr.kd_penata=pn.nip
  LEFT JOIN catatan_sedasi_selama sl ON sl.no_rawat=pr.no_rawat AND sl.tanggal=(SELECT MAX(tanggal) FROM catatan_sedasi_selama WHERE no_rawat=pr.no_rawat)
  LEFT JOIN catatan_sedasi_pasca ps ON ps.no_rawat=pr.no_rawat AND ps.tanggal=(SELECT MAX(tanggal) FROM catatan_sedasi_pasca WHERE no_rawat=pr.no_rawat)
  LEFT JOIN petugas prw ON ps.kd_perawat_ruangan=prw.nip
WHERE pr.no_rawat=$P{no_rawat} AND pr.tanggal=(SELECT MAX(tanggal) FROM catatan_sedasi_pra WHERE no_rawat=$P{no_rawat})]]></queryString>
	<field name="no_rkm_medis" class="java.lang.String"/><field name="nm_pasien" class="java.lang.String"/><field name="tgl_lahir" class="java.lang.String"/><field name="jk" class="java.lang.String"/><field name="tanggal" class="java.lang.String"/><field name="diagnosis" class="java.lang.String"/><field name="tindakan" class="java.lang.String"/><field name="jam_awal" class="java.lang.String"/><field name="jenis_sedasi" class="java.lang.String"/><field name="asisten" class="java.lang.String"/><field name="nm_dokter" class="java.lang.String"/><field name="nm_penata" class="java.lang.String"/>
	<field name="cl_informed_consent" class="java.lang.String"/><field name="cl_obat_anestesi" class="java.lang.String"/><field name="cl_tatalaksana_napas" class="java.lang.String"/><field name="cl_mesin_anestesi" class="java.lang.String"/><field name="cl_obat_emergensi" class="java.lang.String"/><field name="cl_monitoring" class="java.lang.String"/><field name="cl_suction" class="java.lang.String"/>
	<field name="pra_kesadaran" class="java.lang.String"/><field name="gcs_e" class="java.lang.String"/><field name="gcs_v" class="java.lang.String"/><field name="gcs_m" class="java.lang.String"/><field name="pra_airway" class="java.lang.String"/><field name="pra_td" class="java.lang.String"/><field name="pra_nadi" class="java.lang.String"/><field name="pra_nadi_reg" class="java.lang.String"/><field name="pra_rr" class="java.lang.String"/><field name="pra_kanul" class="java.lang.String"/><field name="pra_o2" class="java.lang.String"/><field name="pra_spo2" class="java.lang.String"/>
	<field name="sl_letak" class="java.lang.String"/><field name="sl_airway" class="java.lang.String"/><field name="lama_sedasi" class="java.lang.String"/><field name="lama_tindakan" class="java.lang.String"/><field name="jam_akhir" class="java.lang.String"/><field name="medikasi" class="java.lang.String"/>
	<field name="pasca_kesadaran" class="java.lang.String"/><field name="pasca_airway" class="java.lang.String"/><field name="pasca_td" class="java.lang.String"/><field name="pasca_nadi" class="java.lang.String"/><field name="pasca_nadi_reg" class="java.lang.String"/><field name="pasca_rr" class="java.lang.String"/><field name="pasca_kanul" class="java.lang.String"/><field name="pasca_o2" class="java.lang.String"/><field name="pasca_spo2" class="java.lang.String"/><field name="aldrete" class="java.lang.String"/><field name="keluar_jam" class="java.lang.String"/><field name="pindah_ke" class="java.lang.String"/>
	<field name="ins_pemantauan" class="java.lang.String"/><field name="ins_posisi" class="java.lang.String"/><field name="ins_nyeri" class="java.lang.String"/><field name="ins_mual_muntah" class="java.lang.String"/><field name="ins_diet" class="java.lang.String"/><field name="ins_obat_lain" class="java.lang.String"/><field name="ins_lain" class="java.lang.String"/><field name="nm_perawat" class="java.lang.String"/>
	<title>
		<band height="75" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle"><reportElement x="0" y="0" width="46" height="50"/><imageExpression><![CDATA[$P{logo}]]></imageExpression></image>
			<textField isBlankWhenNull="true"><reportElement x="50" y="0" width="455" height="11"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression><![CDATA["DINAS KESEHATAN " + $P{kabupatenrs}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="50" y="11" width="455" height="14"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{namars}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="50" y="25" width="455" height="10"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement><textFieldExpression><![CDATA[$P{alamatrs}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="50" y="35" width="455" height="9"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="6"/></textElement><textFieldExpression><![CDATA["Telp : " + $P{kontakrs} + "  Email : " + $P{emailrs}]]></textFieldExpression></textField>
			<staticText><reportElement x="490" y="0" width="65" height="10"/><textElement textAlignment="Right"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[RM.IBS.11.005.A/B.2019]]></text></staticText>
			<staticText><reportElement x="490" y="10" width="65" height="10"/><textElement textAlignment="Right"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[REV.01]]></text></staticText>
			<line><reportElement x="0" y="50" width="555" height="1"/><graphicElement><pen lineWidth="1.5"/></graphicElement></line>
			<line><reportElement x="0" y="53" width="555" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
			<staticText><reportElement x="0" y="56" width="555" height="16"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="11" isBold="true"/></textElement><text><![CDATA[ANESTESI SEDASI]]></text></staticText>
		</band>
	</title>
	<detail>
		<band height="778" splitType="Stretch">
			<rectangle><reportElement x="330" y="0" width="225" height="48"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle>
			<staticText><reportElement x="334" y="1" width="55" height="11"/><textElement><font fontName="Tahoma" size="7" isBold="true"/></textElement><text><![CDATA[No.RM]]></text></staticText>
			<textField isBlankWhenNull="true"><reportElement x="392" y="1" width="160" height="11"/><textElement><font fontName="Tahoma" size="7"/></textElement><textFieldExpression><![CDATA[": "+$F{no_rkm_medis}]]></textFieldExpression></textField>
			<staticText><reportElement x="334" y="12" width="55" height="11"/><textElement><font fontName="Tahoma" size="7" isBold="true"/></textElement><text><![CDATA[Nama]]></text></staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="392" y="12" width="160" height="11"/><textElement><font fontName="Tahoma" size="7"/></textElement><textFieldExpression><![CDATA[": "+$F{nm_pasien}]]></textFieldExpression></textField>
			<staticText><reportElement x="334" y="24" width="55" height="11"/><textElement><font fontName="Tahoma" size="7" isBold="true"/></textElement><text><![CDATA[Tgl Lahir]]></text></staticText>
			<textField isBlankWhenNull="true"><reportElement x="392" y="24" width="160" height="11"/><textElement><font fontName="Tahoma" size="7"/></textElement><textFieldExpression><![CDATA[": "+$F{tgl_lahir}+"  ( "+$F{jk}+" )"]]></textFieldExpression></textField>
			<staticText><reportElement x="334" y="36" width="55" height="11"/><textElement><font fontName="Tahoma" size="7" isBold="true"/></textElement><text><![CDATA[Tanggal]]></text></staticText>
			<textField isBlankWhenNull="true"><reportElement x="392" y="36" width="160" height="11"/><textElement><font fontName="Tahoma" size="7"/></textElement><textFieldExpression><![CDATA[": "+$F{tanggal}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="0" y="1" width="325" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA["Diagnosis : "+$F{diagnosis}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="0" y="12" width="325" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA["Tindakan  : "+$F{tindakan}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="0" y="23" width="325" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA["Dokter    : "+($F{nm_dokter}==null?"":$F{nm_dokter})+"   Jam Awal : "+$F{jam_awal}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="0" y="34" width="325" height="11"/><textElement><font fontName="Tahoma" size="8"/></textElement><textFieldExpression><![CDATA["Asisten   : "+$F{asisten}+"   Jam Akhir : "+$F{jam_akhir}]]></textFieldExpression></textField>
			<textField isBlankWhenNull="true"><reportElement x="0" y="49" width="555" height="11"/><textElement><font fontName="Tahoma" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Penata Anestesi : "+$F{nm_penata}+"      Jenis Sedasi : "+$F{jenis_sedasi}]]></textFieldExpression></textField>
