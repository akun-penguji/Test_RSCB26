			<staticText><reportElement x="140" y="183" width="30" height="12"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="Tahoma" size="6" isBold="true"/></textElement><text><![CDATA[RR]]></text></staticText>
