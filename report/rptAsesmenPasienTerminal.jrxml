<?xml version="1.0" encoding="UTF-8"?>
<!-- Asesmen Pasien Tahap Terminal - RM.KEP.08.002 - RSUD Cabangbungin -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptAsesmenPasienTerminal" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b1c2d3e4-0000-0000-0000-000000000001">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[select a.*, p.nm_pasien, p.no_rkm_medis, p.jk, DATE_FORMAT(p.tgl_lahir,'%d-%m-%Y') as tgl_lahir, concat(p.alamat) as alamat_pasien, dk.nm_dokter as dpjp, pg.nama as nama_petugas, DATE_FORMAT(a.tanggal,'%d-%m-%Y') as tanggal_cetak, ifnull((select bangsal.nm_bangsal from kamar_inap join kamar on kamar_inap.kd_kamar=kamar.kd_kamar join bangsal on kamar.kd_bangsal=bangsal.kd_bangsal where kamar_inap.no_rawat=a.no_rawat order by kamar_inap.tgl_masuk desc, kamar_inap.jam_masuk desc limit 1), poliklinik.nm_poli) as ruangan from asesmen_pasien_terminal a inner join reg_periksa r on a.no_rawat=r.no_rawat inner join pasien p on r.no_rkm_medis=p.no_rkm_medis left join dokter dk on r.kd_dokter=dk.kd_dokter left join poliklinik on r.kd_poli=poliklinik.kd_poli left join petugas pg on a.nip=pg.nip where a.no_rawat='-']]>
	</queryString>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="no_rkm_medis" class="java.lang.String"/>
