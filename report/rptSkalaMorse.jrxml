	<queryString>
		<![CDATA[select s.*,r.no_rkm_medis,p.nm_pasien,p.tgl_lahir,p.no_ktp,pt.nama as nm_petugas from skala_morse s inner join reg_periksa r on s.no_rawat=r.no_rawat inner join pasien p on r.no_rkm_medis=p.no_rkm_medis left join petugas pt on s.nip=pt.nip]]>
	</queryString>
