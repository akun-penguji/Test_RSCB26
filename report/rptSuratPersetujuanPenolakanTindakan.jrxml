				<textFieldExpression><![CDATA["Dengan ini saya menyatakan bahwa saya "+$F{nm_dokter} +" telah menerangkan hal-hal diatas secara benar dan jelas dan memberikan kesempatan untuk bertanya dan atau berdiskusi"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="409" width="470" height="26" uuid="b67d10d1-58e5-45bf-8f1a-b512ebb3641e"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Dengan ini saya menyatakan bahwa saya /Keluarga pasien "+ $F{nm_pasien}+" Telah menerima  informasi sebagaimana diatas yang saya beri tanda / paraf di kolom kanannya serta telah diberi kesempatan untuk bertanya / berdiskusi, dan telah memahaminya"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="436" width="550" height="14" uuid="f448c7b1-4712-42a0-ba82-41c29193b0dd"/>
				<textElement>
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Keterangan : jika pasien tidak kompeten atau tidak mau menerima informasi, maka penerima informasi adalah wali atau keluarga terdekat]]></text>
			</staticText>
