	<subDataset name="dsRetriaseLog" uuid="c1d2e3f4-a5b6-7890-cdef-012345678901">
		<parameter name="p_triase_id" class="java.lang.Long"/>
		<queryString>
			<![CDATA[SELECT rl.waktu_retriase, rl.kategori_lama, rl.kategori_baru, rl.alasan,
			         COALESCE(pt.nama, rl.nip_petugas) AS nm_petugas
			FROM retriase_log rl
			LEFT JOIN petugas pt ON rl.nip_petugas = pt.nip
			WHERE rl.triase_id = $P{p_triase_id}
			ORDER BY rl.waktu_retriase]]>
		</queryString>
		<field name="waktu_retriase" class="java.lang.String"/>
		<field name="kategori_lama" class="java.lang.String"/>
		<field name="kategori_baru" class="java.lang.String"/>
		<field name="alasan" class="java.lang.String"/>
		<field name="nm_petugas" class="java.lang.String"/>
	</subDataset>
