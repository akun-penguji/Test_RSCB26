				<reportElement x="300" y="346" width="255" height="15" uuid="42274bbb-5b90-4d7c-b1f5-5a363303b601"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["Bekasi, "+new java.text.SimpleDateFormat("dd MMMM yyyy",new java.util.Locale("id","ID")).format($F{tanggal})]]></textFieldExpression>
