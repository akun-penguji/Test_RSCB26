					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[FORMULIR PERNYATAAN JANGAN DILAKUKAN RESUSITASI]]></text>
			</staticText>
			<staticText>
				<reportElement x="5" y="48" width="545" height="15" uuid="d41752f3-069b-4467-8220-715ea048122e"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="10" isBold="true"/>
				</textElement>
				<text><![CDATA[DNR (DO NOT RESUSCITATE)]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="75" width="555" height="15" uuid="0d9f1bb0-8dc0-4207-b755-641a91b97b3c"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<text><![CDATA[Saya yang bertanda tangan di bawah ini :]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="97" width="100" height="15" uuid="45fe4b29-c237-41f4-b920-7aad1eb36fc7"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
