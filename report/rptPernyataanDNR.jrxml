					<font size="9"/>
				</textElement>
				<text><![CDATA[Tanggal Lahir]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="117" width="10" height="15" uuid="392b5ee4-ce27-4e7e-ac2b-6cf09e8827a9"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
