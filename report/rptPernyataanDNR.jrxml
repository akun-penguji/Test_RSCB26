				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{tgl_lahir}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="145" width="555" height="15" uuid="9d77f93b-6af9-4593-b144-6299eb3430ca"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<text><![CDATA[Dengan ini saya menyatakan bahwa saya telah membuat keputusan dan menyetujui perintah]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="160" width="555" height="15" uuid="af52b1bb-2ff6-4fb0-bfea-8bee26365ce4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9" isItalic="true"/>
				</textElement>
				<text><![CDATA[do not resuscitate (jangan diresusitasi).]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="182" width="555" height="15" uuid="55f392d8-e7a8-4ae5-be8b-65419dc4cf72"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["Saya menyatakan bahwa jika jantung saya/"+($F{hubungan}==null || $F{hubungan}.isEmpty()?"":$F{hubungan})+" saya berhenti berdetak, atau"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="197" width="555" height="15" uuid="f3b87610-589c-4c73-91f8-f3be9182b3c4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<text><![CDATA[berhenti bernafas, tidak ada prosedur medis untuk mengembalikan fungsi bernafas atau]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="212" width="555" height="15" uuid="6a98df95-bbbe-4226-ae1e-9138525e0eb2"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["berfungsi kembali jantung saya MENOLAK untuk dilakukan resusitasi jantung pada"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="227" width="555" height="15" uuid="d00133e1-6d75-43f9-8c6a-8d19daccdb2b"/>
				<textElement verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["saya/"+($F{hubungan}==null || $F{hubungan}.isEmpty()?"":$F{hubungan})+" saya."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="249" width="555" height="15" uuid="0142a9f1-cb00-4f8c-abeb-998a7993bd4e"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<text><![CDATA[Saya memahami bahwa keputusan ini tidak akan mencegah menerima pelayanan kesehatan]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="264" width="555" height="15" uuid="4ceabcc0-08d9-4df7-98df-6294447fdf78"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<text><![CDATA[lainnya seperti pemberian Maneuver Heimlich atau pemberian oksigen dan langkah-langkah]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="279" width="555" height="15" uuid="de269ee3-aba6-4233-9c22-4006a5fb63da"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<text><![CDATA[perawatan untuk meningkatkan kenyamanan lainnya.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="301" width="555" height="15" uuid="d11d9413-44e6-4c7e-bb5a-a8cf5ddbaedf"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<text><![CDATA[Saya memberikan izin agar informasi ini diberikan kepada seluruh staf Rumah Sakit, saya]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="316" width="555" height="15" uuid="81da1b51-f43c-4159-bca1-7a95dcd9aaa9"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<text><![CDATA[memahami bahwa saya dapat mencabut pernyataan ini setiap saat.]]></text>
			</staticText>
